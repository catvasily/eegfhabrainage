            # If null, figure size is derived from width/height per physician panel
            "figure_size": [12,8],
            "width_per_physician": 4.8,
            "height_per_physician": 5.0,

            # X-axis limits for PredConfidence density plots (predicted-label probability)
            "x_limits": [0.0, 1.0],

            # X-axis limits for STDConfidence/STD aggregate density plots.
