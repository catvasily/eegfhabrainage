                }   # end of "joint_prediction"
            },  # end of summarize

        # Settings for visualizing confidences plot from summary CSV data
        "ridge_plots": {
            # --------------------------------------------------------------------------------------------------
            # !!! NOTE: the "ignore_confidence" setting for the models used is taken from the "summarize" key !!! 
            # --------------------------------------------------------------------------------------------------

            "enabled": false,
            "show_plot": true,
            "dpi": 300,

            "style": "white",
            "context": "paper",

            # Number of physician columns in the outer grid
