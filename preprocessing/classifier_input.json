        "model": {
            "n_jobs": 4,        # Use multithreading when running prediction step, if supported
                                # (does not seem to have any effect)
            
            # Specifies which model to use: WHEN TOP LEVEL PICKLE FILE IS NULL, a set of parms that uniquely
