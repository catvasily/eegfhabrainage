            "y_limits": [-5,15],
            #"y_limits": [-20,30],       # Focal Epi
            #"y_limits": [-20,30],       # Gen Epi

            # Top-to-bottom fill colors for the four ridge rows:
            # healthy green -> light green -> orange -> dangerous red
            # (TrueLabel,Confident) = (0,1), (0,0), (1,0), (1,1)
            "colors": ["#1a9850", "#91cf60", "#fc8d59", "#d73027"],

            # Optional labels for the 4 confidence/label subsets
            "subset_labels": {
                "0_1": "Conf/N",
                "0_0": "Non-conf/N",
                "1_0": "Non-conf/A",
                "1_1": "Conf/A",
                "overall": "Overall"
                },

            # Colors for the overall row (used for correct/mismatch KDEs).
