            "pair_gap": 0.02,                   # Gap between bar pairs
            "legend_font_size": 9,
            "legend_title_font_size": 10,
            "legend_max_rows": 3,               # Maximum number of legend rows
            "legend_loc": "upper center",      # Matplotlib legend location
            "legend_bbox_to_anchor": [0.55, 1.0],# Optional anchor [x, y]; null for default
            "dpi": 300
        },

        "auc4physician": {
            "input_csv": "auc4physician260331.csv",  # absolute path or relative to out_root
            "output_png": "auc4physician260331.png",         # absolute path or relative to out_root
            "dim_reduction": ["to_lobes","ccv-fcls"],        # one or more methods; one subplot per item
            "title": "AUC by label and physician (fixed dim reduction)",
            "legend_title": "Physician",
            "figure_size": [19, 10],
            "y_limits": [0.0, 1.0],
            "bar_width": 0.055,
            "pair_gap": 0.01,                       # Gap between bar pairs
            "group_gap": 0.01,                      # gap between adjacent physician bars in each label group
            "legend_font_size": 9,
            "legend_title_font_size": 10,
            "legend_max_rows": 3,                   # Maximum number of legend rows
            "legend_loc": "upper center",          # Matplotlib legend location
            "legend_bbox_to_anchor": [0.59, 1.01],    # Optional anchor [x, y]; null for default
            "dpi": 300
        }
