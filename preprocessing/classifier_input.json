            "overall_mismatch_color": "#9ecae9",

            "kde_bw_adjust": 0.2,   # Relative kernel with compared to default one
            "kde_n_points": 256,    # Number of points used to evaluate KDE curves
            "fill_alpha": 0.8,
            "line_width": 1.2,
            "single_value_height": 1.0,  # Vertical marker height when subset has one value only

            "mismatch_density_scale": "auto",  # "auto": scale + and - by subset fractions; numbers
                                               # If an FP number - then this is scaling of mismatched KDE; the matched
                                               # KDE will use scale 1 (that is - not scaled).
            "symmetric_signed_y": true,          # Force signed ridges to use symmetric y-limits around 0

            # Spacing controls
            "grid_hspace": 0.28,
            "grid_wspace": 0.18,
            "ridge_hspace": -0.35,

            "title": null,
            "title_font_size": 12,
            "title_y": 0.995,

            "physician_title_prefix": "", # prefix in front of physician name, i.e."Model physician: ",
            "mean_title_prefix": "",      # prefix for aggregate plots, i.e. "Aggregate: ",
            "joint_confidence_panel_label": "Joint",    # The full label will be this + (joint method)
            "std_confidence_panel_label": "Confidence STD",
            "physician_title_font_size": 10,

            # When true, show x-axis ticks/labels on every ridge panel instead of only the bottom row.
            "show_x_axis_on_all_ridges": true,
            # When true, show y-axis spines and tick labels for every ridge row
            # in the left-most column of ridge panels.
            "show_y_axis_on_leftmost_ridges": true,
            # Inner spacing used (at minimum) when all ridge rows must show x-axes.
            # This avoids overlap that can hide axis lines.
            "ridge_hspace_with_all_x_axes": 0.08,
            "pane_x_label": "Confidence",       # Label for horizontal axis in the bottom ridge row
            "std_x_label": "STD (Confidence)",  # Need a different x-label for the STD KDE plot
            "show_pane_y_label": true,          # Show vertical axis label on each ridge pane
            "pane_y_label": "KDE",              # Vertical axis label text for ridge panes
            "subset_font_size": 8
            },  # end of ridge_plots

        # Settings for visualizing correct/incorrect predicted labels counts from summary CSV data
        "counts_bar_plot": {
            # -----------------------------------------------------------------------------
            # Creates 10 panels arranged in 5 rows x 2 columns:
            # Left column: per-physician + joint percentages (correct up, incorrect down).
            #              Within each group, positive and negative parts sum to 100%.
            # Right column: STD of physician correct-percentage values across physicians only
            #               (joint excluded). Incorrect-percentage STD is not plotted separately,
            #               since it is identical to correct-percentage STD.
            # Rows 1-4 follow the standard confident/non-confident x normal/abnormal subsets.
            # Row 5 is the overall subset, ignoring both true-label class and confidence.
            # -----------------------------------------------------------------------------

            "enabled": false,
            "show_plot": true,
            "dpi": 300,

            "style": "whitegrid",
            "context": "paper",

            # If null, width/height below are used.
            "figure_size": null,
            "width": 12.0,
            "height": 11.0,

            # Relative panel widths [left_column, right_column].
            # Left column should be much wider due to more bar groups.
            "column_width_ratio": [6.0, 1.8],

            # Colors for rows in this order:
            # (TrueLabel,Confident) = (0,1), (0,0), (1,0), (1,1)
            # If omitted, falls back to ridge_plots.colors.
            "colors": ["#1a9850", "#91cf60", "#fc8d59", "#d73027"],

            # Optional labels for the 4 confidence/label subsets
            "subset_labels": {
                "0_1": "Conf/N",
                "0_0": "Non-conf/N",
                "1_0": "Non-conf/A",
                "1_1": "Conf/A",
                "overall": "Overall"
                },

            # Colors for the overall row, which does not map to a single true-label subset.
            "overall_match_color": "#4c78a8",
            "overall_mismatch_color": "#9ecae9",

            # Group label used for the joint-model group in left panels.
            # If empty/null, defaults to "Joint (LR)" or "Joint (Bayes)".
            "joint_group_label": "Joint",

            # Width of crossing bars in each group.
            "bar_width": 0.36,

            # Optional separate width for the right-column STD bars.
            # If omitted, bar_width is used.
            "std_bar_width": 0.22,

            # Fixed x-axis span for right-column STD panels.
            # This prevents Matplotlib autoscaling from hiding changes in std_bar_width.
            "std_panel_x_limits": [-0.75, 0.75],

            # When true, the y=0 baseline in right-column STD panels is vertically aligned
            # with the left-column baseline in the same row. In this mode, right_y_limits/std_y_limits
            # control the STD scale, but the negative bound may be expanded to preserve alignment.
            "align_std_zero_with_left": true,

            # Shared y-limits across all left-column panels (percentages).
            # null -> auto symmetric range computed from all left panels.
            #"left_y_limits": [-50, 100],
            #"left_y_limits": [-90, 100],        # Focal Epi
            "left_y_limits": [-90, 100],        # Gen Epi

            # Shared y-limits across all right-column STD panels.
            # null -> auto range computed from all right panels.
            # Backward-compatible alias: std_y_limits.
            # When align_std_zero_with_left=true, the positive limit is preserved as scale guidance,
            # and the negative limit may be adjusted so the y=0 baseline aligns with the left column.
            "right_y_limits": [0,15],
            #"std_y_limits": null,

            "left_y_label": "Percentage",
            "std_y_label": "Percentage STD",
            "left_x_label": "Physician / Joint",
            "std_x_label": "STD across physicians",

            "panel_title_font_size": 10,
            "title": null,
            "title_font_size": 12,
            "title_y": 0.995,

            "grid_hspace": 0.35,
            "grid_wspace": 0.25
            },  # end of counts_bar_plot

        "grid_pr_plot": {
            # PR-curve grid from predict_summary...csv records (scan-level rows only).
            # Rows are plotted top-to-bottom as subsets:
            # 1) Confident true labels (Confident=1)
            # 2) Non-confident true labels (Confident=0)
            # 3) All eligible records
            #
            # Each panel overlays 2 curves:
            # - Physician model curve for that subset
            # - Joint model curve for that subset
            #
            # Eligibility rules:
            # - Physician curves use all rows in subset
            # - Joint curves use only rows with held_out_set=0 in subset
            # - Rows with ScanID starting with "brier_scores_" are dropped
            # - TrueLabel/Confident must be binary (0/1)
            "enabled": true,
            "show_plot": true,
            "dpi": 300,

            "style": "whitegrid",
            "context": "paper",

            # If null/empty, output file is written next to summary CSV as
            # <summary_csv_stem>_grid_pr_plot.png
            "output_png": null,

            # Physician panel geometry within each subset row block.
            # For 5 physicians, keep this as 1 x 5.
            "n_panel_rows": 1,
            "n_panel_cols": 5,

            # If null, figure size is inferred from width_per_col and
            # height_per_subset_row.
            "figure_size": null,
            "width_per_col": 3.8,
            "height_per_subset_row": 2.8,

            "x_limits": [0.0, 1.0],
            "y_limits": [0.3, 1.0],

            "x_label": "Recall",
            "y_label": "Precision",
            "confident_label": "Confident",
            "nonconfident_label": "Non-confident",
            "all_label": "All",

            "title": null,
            "title_font_size": 12,
            "title_y": 0.995,
            "panel_title_font_size": 10,

            "physician_curve_color": "#4c78a8",
            "joint_curve_color": "#f58518",
            "joint_line_style": "--",
            #"line_width": 1.8,
            "line_width": 3,

            "show_legend": true,
            "legend_loc": "lower left",
            "legend_font_size": 7,
            "legend_frame": false,

            "physician_label_template": "{physician} (AP={ap:.3f}, n={n})",
            "joint_label_template": "Joint (AP={ap:.3f}, n={n})",
            "no_curve_text": "insufficient class variation",
            "note_font_size": 7,

            "grid_alpha": 0.3,
            "hspace": 0.35,
            "wspace": 0.2
        },

        "aucs_bar_plot": {
            # PR AUC bars from summarize-only CSV summary rows.
            # Rows are plotted top-to-bottom as:
            # 1) PR_AUC_confident
            # 2) PR_AUC_nonconfident
            # 3) PR_AUC
            "enabled": false,
            "show_plot": true,
            "dpi": 300,

            "style": "whitegrid",
            "context": "paper",

            # If null/empty, output file is written next to summary CSV as
            # <summary_csv_stem>_pr_auc_bar_plot.png
            "output_png": null,

            "figure_size": [10.0, 11.0],
            "bar_width": 0.72,
            "y_limits": [0.0, 1.0],

            # Optional CI whiskers parsed from text values like
            # "0.812 (0.754, 0.864)" in summary rows.
            "show_ci": true,
            "ci_capsize": 4.0,
            "ci_line_width": 1.1,

            # If provided, must contain >= number_of_physicians + 1 entries.
            # Otherwise physician_color/joint_color are used.
            "colors": null,
            "physician_color": "#4c78a8",
            "joint_color": "#f58518",
            "missing_color": "#c7c7c7",
            "joint_group_label": "Joint",

            # Summary rows and joint column names as produced by summarize-only mode.
            "subset_rows": {
                "confident": "PR_AUC_confident",
                "nonconfident": "PR_AUC_nonconfident",
                "overall": "PR_AUC"
                },

            "joint_auc_column": "JointConfidence",

            "confident_label": "Confident labels",
            "nonconfident_label": "Non-confident labels",
            "overall_label": "Overall",

            "title": null,
            "title_font_size": 12,
            "title_y": 0.995,
            "pane_title_font_size": 10,

            "x_label": "Physicians and Joint model",
            "y_label": "PR AUC",

            "show_value_labels": true,
            "value_label_format": "{:.3f}",
            "value_label_font_size": 8,

            "grid_alpha": 0.25,
            "grid_hspace": 0.28
            },  # end of aucs_bar_plot

        "mcc_error_plot": {
            # Pairwise physician error-correlation matrix (MCC over error vectors).
            # Uses summary CSV rows where TrueLabel and physician predicted labels are binary.
            "enabled": false,
            "show_plot": true,
            "dpi": 300,

            "style": "white",
            "context": "paper",

            # If null/empty, output file is written next to summary CSV as
            # <summary_csv_stem>_mcc_error_heatmap.png
            "output_png": null,

            "figure_size": [8.0, 6.8],
            "title": null,
            "title_font_size": 12,
            "title_y": 0.995,

            "x_label": "Physician model",
            "y_label": "Physician model",
            "label_font_size": 10,
            "tick_font_size": 9,

            "cmap": "RdBu_r",
            "vmin": -1.0,
            "vmax": 1.0,
            "center": 0.0,
            "square": true,

            "annot": true,
            "fmt": ".2f",
            "linewidths": 0.5,
            "linecolor": "white",

            "cbar": true,
            "cbar_label": "MCC of error vectors"
            }   # end of mcc_error_plot
        },  # end of "predict" key

