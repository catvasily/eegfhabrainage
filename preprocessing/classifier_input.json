                },

            "sources": {
                #"data_root": "/home/amoiseev/projects/rpp-doesburg/amoiseev/data/eegfhabrainage/src-cwt"
                "data_root": "/project/6019337/databases/eeg_fha/beamformed/001_a01_01/destrieux/weibull",
