	        "hospital": ["Abbotsford"],             # One hospital or a list of any of "Abbotsford",
            "physician": null,      # When null or empty list, model based on all physician's records
                                    # will be used
                                                    # "Burnaby", "RCH", "Surrey" 
            "target_label": "Abnormality",    # One of labels listed in "classifications_cols"
            "dim_reduction": "to_lobes",    # Method: 'pca', 'to_lobes', 'epi_features', or 'none'
            "use_moments_only": true,      # Flag to use only moments and drop Weibull dist parms
            "standardize_features": false,   # Flag to standardize features 
            "ignore_confidence": false,       # Flag to collaps high and low confident labels

            "threshold_selection": "f1"     # Method for setting the threshold for choosing class label
                                            # Possible values are: F1
                                            # null means that a default 0.5 threshold will be used
            },

        "input_records": {    
            "hospital": ["Burnaby","Abbotsford","RCH","Surrey"],    # A list with one of: Burnaby, Abbotsford, RCH, Surrey
            "physician": ["Others"],   # Empty list, null, or list of physician names for the EEG scans.
                                       # If specified, others physicians' records will be dropped.
            #"physician": ["Ioanna","Anastasia","Despina","Katerina","Elektra","Calliope","Daphne",
            #              "Penelope","Thalia","Chloe","Nefeli","Elara","Theodora"],
            "scan_ids": null,                       # null or a list of specific record IDs
            "ignore_confidence": false       # Flag to collaps high and low confident labels
            },

        # Settings for summarizing results of different physicians on the same set of input records
        "summarize": {
            "hospital": ["Abbotsford","Burnaby","RCH","Surrey"],    # A list with one of: Burnaby, Abbotsford, RCH, Surrey
            "target_label": "Abnormality",    # One of labels listed in "classifications_cols"
            #"target_label": "Focal Epi",
            #"target_label": "Gen Epi",
            #"target_label": "Focal Non-epi",
            #"target_label": "Gen Non-epi",
            "dim_reduction": "ccv",         # Method: 'pca', 'to_lobes', 'epi_features', or 'none'
            "use_moments_only": true,       # Flag to use only moments and drop Weibull dist parms
            "standardize_features": false,  # Flag to standardize features 
            "ignore_confidence": false,     # Flag to collaps high and low confident labels in the models used
            "model_physicians":             # List of physicians whose models were used
                ["Sophia","Maria","Eleni","Zoe","Athina"],
            "target_physicians": ["Others"],
            
            # Bootstrap settings for AUC, F1 conf intervals estimates
            "n_bootstraps": 2000,               # Number of bootstrap resamplingsp use at least 1000
            "ci_level": 0.95,                   # Confidence interval size 

            "joint_prediction": {
                "method": "joint_LR",              # Ensemble learning method. "bayes" - use naive Bayes approach
                                                # "joint_LR" - use logistic regression
                "n_splits": 5,                  # Number of splits for stratified K-fold to split target physician's
                                                # data into outer train/test parts (K)
                "n_inner_splits": 4,            # Number of inner splits (M) on each outer-train fold for
                                                # constructing OOF train scores used for calibration/thresholding
                "threshold_selection": "f1",    # Method for setting the threshold for joint class label
                                                # Possible values are: F1. null means that a default 0.5 is used
                "calibrate_scores": true,      # Flag to calibrate the joint model prediction scores
